type User = {
    name: Str,
    age: Int,
    role: Str
}

fn main(): Int {
    let users = [
        User{ name: "a", age: 20, role: "admin" },
        User{ name: "b", age: 15, role: "user" },
        User{ name: "c", age: 25, role: "user" }
    ]

    // Kix has no implicit field lambdas; write explicit closures instead.
    let adults = users.filter(fn(u: User): Bool = u.age >= 18)
    let names = users.map(fn(u: User): Str = u.name)
    let admin = users.find(fn(u: User): Bool = u.role == "admin")
    0
}
