// Expression-bodied functions and control-flow blocks.
//
// Kix uses `=` for a single-expression function body and `{ ... }` blocks
// for the bodies of `if`, `while` and `for`.

fn square(value: Int): Int = value * value

fn classify(value: Int): Int {
    return if value > 0 { 1 } else { 0 }
}

fn main(): Int {
    let mut total = 0
    let mut index = 0

    while index < 4 { index = index + 1 }
    for value in [1, 2, 3] { total = total + square(value) }

    if classify(total) == 1 { print("positive") }
    return total
}
