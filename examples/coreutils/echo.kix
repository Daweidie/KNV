use String

fn printf(format: *u8): Int
fn getenv(name: *u8): *u8
fn strcmp(a: *u8, b: *u8): Int

fn main(argc: Int, argv: *u8): Int {
    let mut arg = 0
    for i in 1 .. argc {
        if strcmp(argv[i], "-n") == 0 {
            arg = 1
            continue
        }
        if arg == 0 {
            printf("%s ", argv[i])
        } else if arg == 1 {
            printf("%s ", argv[i])
        }
    }
    if arg == 0 {
        printf("\n")
    }
    return 0
}
