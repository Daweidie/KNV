fn lexer(s: Str): Int {
    for i in 0 .. s.length {
        let c = s[i]
        if c == ' ' {
            continue
        }
        else if c >= '0' && c <= '9' {
            print("Number")
        }
        else if c == '+' || c == '-' || c == '*' || c == '/' {
            print("Operator")
        }
        else if c == '=' {
            print("Equals")
        }
        else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
            print("Identifier")
        }
        else {
            print("Unknown")
        }
    }
    return 0
}

