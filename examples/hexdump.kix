// extern "C" printf is declared as a signature-only Kix function.
fn printf(fmt: Str): Int

fn print_hex_to_ascii_and_very_pretty(s: Str): Int {
    for i in 0 .. s.length {
        printf("%02x ", s[i])
        if i % 16 == 15 {
            printf(" ")
            for j in (i - 15) .. (i + 1) {
                let c = s[j]
                if c >= ' ' && c <= '~' {
                    printf("%c", c)
                }
                else {
                    printf(".")
                }
            }
            printf("\n")
        }
    }
    if s.length % 16 != 0 {
        let remaining = 16 - (s.length % 16)
        for _ in 0 .. remaining {
            printf("   ")
        }
        printf(" ")
        for i in (s.length - (s.length % 16)) .. s.length {
            let c = s[i]
            if c >= ' ' && c <= '~' {
                printf("%c", c)
            }
            else {
                printf(".")
            }
        }
        printf("\n")
    }
    return 0
}

fn main(argc: Int, argv: &Str): Int {
    if argc < 2 {
        printf("Usage: hexdump <your_text>\n")
        return 1
    }
    print_hex_to_ascii_and_very_pretty(argv[1])
    return 0
}
