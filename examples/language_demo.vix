fn fib(n: i32): i32
{
    let mut a = 0
    let mut b = 1
    for (index in 0 .. n) {
        let next = a + b
        a = b
        b = next
    }
    return a
}

fn main(): i32
{
    let value = fib(10)
    let description = if (value >= 50) { "large" } else { "small" }

    print("Vix demo")
    print(value)
    print(description)
    return 0
}
