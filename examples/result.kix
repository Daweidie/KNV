type Result[T, E] = Ok(T) | Err(E)

fn main(): Int {
    let ok = Ok(42) as Result[Int, Str]
    let bad = Err("division by zero") as Result[Int, Str]

    match ok {
        Ok(v) => print(v)
        Err(e) => print(e)
    }

    match bad {
        Ok(v) => print(v)
        Err(e) => print(e)
    }

    return 0
}
