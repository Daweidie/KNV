fn classify_fruit(name: Str): Int {
    match name {
        "apple" => { return 1 }
        "banana" => { return 2 }
        "cherry" => { return 3 }
        "date" => { return 4 }
        _ => { return 0 }
    }
    return 0
}

fn main(): Int {
    let fruits = ["apple", "banana", "cherry", "date", "elderberry"]
    for i in 0 .. 5 {
        let result = classify_fruit(fruits[i])
        if result == 0 {
            print("unknown fruit")
        }
        else if result == 1 {
            print("apple detected")
        }
        else if result == 2 {
            print("banana detected")
        }
        else if result == 3 {
            print("cherry detected")
        }
        else {
            print("date detected")
        }
    }
    return 0
}
