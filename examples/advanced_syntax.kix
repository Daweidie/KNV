type NumberResult = Valid(Int) | Invalid(Str)

fn double(value: Int): Int {
    return value * 2
}

fn validate(value: Int): NumberResult {
    if value < 0 { return Invalid("negative number") }
    return Valid(value)
}

fn main(): Int {
    let result = 21 |> double |> validate
    let mut output = 1

    match result {
        Valid(value) => output = value
        Invalid(_) => output = 1
    }
    return output
}
