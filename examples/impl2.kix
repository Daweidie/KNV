fn sqrt(x: f64): f64

type Point = {
    x: Int,
    y: Int
}
impl Point {
    fn length(self): f64 {
        return sqrt(self.x * self.x + self.y * self.y)
    }
    fn move(mut self, dx: Int, dy: Int) {
        self.x = self.x + dx
        self.y = self.y + dy
    }
    fn new(x: Int, y: Int): Point {
        return Point{ x: x, y: y }
    }
}
fn main(): Int {
    let mut p = Point{ x: 3, y: 4 }
    print(p.length())  // 5.0
    p.move(1, 1)       // (4, 5)
    print(p.length())  // 6.403124
    return 0
}
