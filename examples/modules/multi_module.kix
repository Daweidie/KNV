// multi_module.kix — 多模块示例
// 演示：同时声明多个模块并分别调用
//
// 文件结构：
//   multi_module.kix   ← 入口
//   math.kix           ← 数学模块
//   counter.kix        ← 计数器模块（含记录类型）
//
// 解析验证：
//   ./build/kixc-stage0 --lang=kix --ast-json examples/modules/multi_module.kix
//   # 示例语义：退出码 0，打印运行结果

mod math
mod counter

use math::add
use math::mul
use math::abs_val
use counter::counter_new
use counter::counter_inc
use counter::counter_get

fn main(): Int
{
    // 使用 math 模块
    let sum  = math::add(10, 5)      // 15
    let prod = math::mul(3, 7)       // 21
    let neg  = math::abs_val(0 - 8)  // 8

    print(math::add(sum, prod))  // 36

    // 使用 counter 模块（记录类型）
    let mut c = counter::counter_new(3)
    counter::counter_inc(c)  // value = 3
    counter::counter_inc(c)  // value = 6
    counter::counter_inc(c)  // value = 9

    print(counter::counter_get(c))  // 9

    return 0
}
