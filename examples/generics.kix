/*
generics
*/
fn printf(format: Str): Int
type Box[T] = {
	value: T
}

fn id[T](value: T): T {
	return value
}
fn add[T](a: T, b: T): T {
    return a + b
}
type Flag[T] = On | Off

fn main(): Int {
	let b = Box[Int]{ value: 10 }
	let x = id[Int](b.value)
    let y = add[Int](4,6)
    let z = add[f64](2.5, 3.5)
    printf("b = %d\n", b.value)
    printf("x = %d\n", x)
	printf("y = %d\n", y)
	printf("z = %f\n", z)
    match x {
        10 => {
            printf("OK\n")
        }
        _ => {
            printf("FAIL\n")
            return 1
        }
    }
	let state = On
	match state {
		On => {
			printf("OK\n")
		}
		Off => {
			printf("FAIL\n")
			return 1
		}
	}
	return 0
}
