#[no_main]

extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32
    fn atof(text: string): f64
    fn fopen(filename: ptr, mode: ptr): ptr
    fn fclose(file: ptr): i32
    fn fread(buf: ptr, size: i64, count: i64, file: ptr): i64
    fn fseek(file: ptr, offset: i64, whence: i32): i32
    fn ftell(file: ptr): i64
    fn vix_lexer_peek_char(src: string, pos: i32): ?i32
    fn vix_lexer_next_non_space_char(src: string, pos: i32): ?i32
    fn compiler_string_byte(text: string, index: i32): i32
}

pub fn i32_to_str(n: i32): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%d", n)
    return buf
}

pub fn f64_to_str(n: f64): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%g", n)
    return buf
}

pub fn tk_ident(): i32 { return 1 }
pub fn tk_number(): i32 { return 2 }
pub fn tk_keyword(): i32 { return 3 }
pub fn tk_symbol(): i32 { return 4 }
pub fn tk_string(): i32 { return 5 }
pub fn tk_eof(): i32 { return 6 }
pub fn tk_bool(): i32 { return 7 }
pub fn tk_float(): i32 { return 8 }
pub fn tk_char(): i32 { return 9 }
pub fn tk_raw_string(): i32 { return 10 }
pub fn tk_byte_string(): i32 { return 11 }
pub fn tk_doc_comment(): i32 { return 12 }
pub fn tk_error(): i32 { return 13 }

pub type TokenOrigin = TokenCallSite | TokenDefinitionSite | TokenGenerated

pub type TokenStream = struct {
    kinds: [i32],
    texts: [string],
    ints: [i32],
    floats: [f64],
    lines: [i32],
    columns: [i32],
    starts: [i32],
    ends: [i32],
    // Keep the ADT at the API boundary, but store its compact stable tag in
    // the parallel token array.  The current bootstrap runtime cannot safely
    // retain ADT values in a growable array during macro expansion.
    origins: [i32],
    hygiene_ids: [i32]
}

pub fn stream_new(): TokenStream
{
    return TokenStream{ kinds: [], texts: [], ints: [], floats: [], lines: [], columns: [], starts: [], ends: [], origins: [], hygiene_ids: [] }
}

pub fn token_origin_rank(origin: TokenOrigin): i32
{
    return match origin { TokenCallSite -> 0 TokenDefinitionSite -> 1 TokenGenerated -> 2 }
}

pub fn token_origin_from_rank(origin: i32): TokenOrigin
{
    return match origin { 1 -> TokenDefinitionSite 2 -> TokenGenerated _ -> TokenCallSite }
}

pub fn stream_push(stream: &TokenStream, kind: i32, text: string, int_value: i32, line: i32, column: i32)
{
    stream_push_full(stream, kind, text, int_value, 0.0, line, column)
}

pub fn stream_push_full(stream: &TokenStream, kind: i32, text: string, int_value: i32, float_value: f64, line: i32, column: i32)
{
    stream_push_origin(stream, kind, text, int_value, float_value, line, column, -1, -1, TokenCallSite, 0)
}

pub fn stream_push_origin(stream: &TokenStream, kind: i32, text: string, int_value: i32, float_value: f64, line: i32, column: i32, start: i32, end: i32, origin: TokenOrigin, hygiene_id: i32)
{
    stream_push_origin_rank(stream, kind, text, int_value, float_value, line, column, start, end, token_origin_rank(origin), hygiene_id)
}

// Internal rank-based entry point for source-map rebuilding.  Keeping the
// compact rank across the token loop avoids constructing an ADT temporary for
// every token; bootstrap-generated loop temporaries otherwise remain live on
// the native stack until the function returns.
pub fn stream_push_origin_rank(stream: &TokenStream, kind: i32, text: string, int_value: i32, float_value: f64, line: i32, column: i32, start: i32, end: i32, origin_rank: i32, hygiene_id: i32)
{
    stream.kinds.push(kind)
    stream.texts.push(text)
    stream.ints.push(int_value)
    stream.floats.push(float_value)
    stream.lines.push(line)
    stream.columns.push(column)
    stream.starts.push(start)
    stream.ends.push(end)
    stream.origins.push(origin_rank)
    stream.hygiene_ids.push(hygiene_id)
}

pub fn stream_len(stream: &TokenStream): i32
{
    return stream.kinds.length
}

pub fn stream_kind_at(stream: &TokenStream, index: i32): i32
{
    return stream.kinds[index]
}

pub fn stream_text_at(stream: &TokenStream, index: i32): string
{
    return stream.texts[index]
}

pub fn stream_int_at(stream: &TokenStream, index: i32): i32
{
    return stream.ints[index]
}

pub fn stream_float_at(stream: &TokenStream, index: i32): f64
{
    return stream.floats[index]
}

pub fn stream_line_at(stream: &TokenStream, index: i32): i32
{
    return stream.lines[index]
}

pub fn stream_col_at(stream: &TokenStream, index: i32): i32
{
    return stream.columns[index]
}

pub fn stream_start_at(stream: &TokenStream, index: i32): i32 { return stream.starts[index] }
pub fn stream_end_at(stream: &TokenStream, index: i32): i32 { return stream.ends[index] }
pub fn stream_origin_at(stream: &TokenStream, index: i32): TokenOrigin { return token_origin_from_rank(stream.origins[index]) }
pub fn stream_hygiene_at(stream: &TokenStream, index: i32): i32 { return stream.hygiene_ids[index] }

pub fn peek_char(src: string, pos: i32): ?i32
{
    return vix_lexer_peek_char(src, pos)
}
pub fn is_alpha(c: i32): i32
{
    if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_') return 1
    return 0
}

pub fn is_digit(c: i32): i32
{
    if (c >= '0' and c <= '9') return 1
    return 0
}

pub fn is_ident(c: i32): i32
{
    if (is_alpha(c) == 1 or is_digit(c) == 1) return 1
    return 0
}

pub fn char_string(c: i32): string
{
    let s: string = malloc(2)
    s[0] = c
    s[1] = 0
    return s
}

pub fn token_can_end_statement(kind: i32, text: string): i32
{
    if (kind == tk_ident() or kind == tk_number() or kind == tk_float() or kind == tk_string() or kind == tk_bool()) return 1
    if (text == ")" or text == "]" or text == "}" or text == "break" or text == "continue" or text == "return") return 1
    return 0
}

pub fn next_non_space_char(src: string, pos: i32): ?i32
{
    return vix_lexer_next_non_space_char(src, pos)
}

pub fn newline_should_insert_semicolon(src: string, pos: i32, stream: &TokenStream): i32
{
    if (stream_len(stream) == 0) return 0
    let last = stream_len(stream) - 1
    if (token_can_end_statement(stream_kind_at(stream, last), stream_text_at(stream, last)) == 0) return 0
    return match next_non_space_char(src, pos) {
        Some(c) -> {
            if (c == '}' or c == '"' or is_alpha(c) == 1 or is_digit(c) == 1)
            {
                1
            }
            else
            {
                0
            }
        }
        None -> 0
    }
}

pub fn is_keyword(text: string): i32
{
    match text {
        "fn" | "return" | "let" | "mut" | "if" | "elif" | "else" | "while" | "for" | "in" -> return 1
        "match" | "struct" | "type" | "pub" | "import" | "extern" | "break" | "continue" | "mod" | "as" -> return 1
        "i32" | "i64" | "i8" | "f32" | "f64" | "string" | "void" | "nil" | "true" | "false" -> return 1
        "and" | "or" | "print" -> return 1
        _ -> return 0
    }
}

// Kix has its own lexer entry point during the bootstrap transition.  Keeping
// tokenize() unchanged is intentional: the seed still compiles the compiler
// sources as Vix, and Vix regression tests must retain their old token stream.
pub fn is_kix_keyword(text: string): i32
{
    return match text {
        "let" | "mut" | "fn" | "type" | "impl" | "trait" -> 1
        "mod" | "use" | "pub" | "as" -> 1
        "if" | "else" | "match" | "for" | "while" | "in" -> 1
        "return" | "break" | "continue" | "self" | "comptime" -> 1
        _ -> 0
    }
}

pub fn kix_digit_value(c: i32): i32
{
    if (c >= '0' and c <= '9') { return c - '0' }
    if (c >= 'a' and c <= 'f') { return c - 'a' + 10 }
    if (c >= 'A' and c <= 'F') { return c - 'A' + 10 }
    return -1
}

pub fn kix_digit_valid(c: i32, base: i32): i32
{
    let value = kix_digit_value(c)
    if (value >= 0 and value < base) { return 1 }
    return 0
}

pub fn kix_parse_small_int(text: string): i32
{
    let mut base = 10
    let mut pos = 0
    if (text.length >= 2 and compiler_string_byte(text, 0) == '0')
    {
        let marker = compiler_string_byte(text, 1)
        if (marker == 'x' or marker == 'X') { base = 16; pos = 2 }
        elif (marker == 'o' or marker == 'O') { base = 8; pos = 2 }
        elif (marker == 'b' or marker == 'B') { base = 2; pos = 2 }
    }
    let mut value = 0
    while (pos < text.length)
    {
        let c = compiler_string_byte(text, pos)
        if (c == '_') { pos += 1; continue }
        let digit = kix_digit_value(c)
        if (digit < 0 or digit >= base) { break }
        value = value * base + digit
        pos += 1
    }
    return value
}

pub fn kix_token_cannot_end_line(kind: i32, text: string): i32
{
    if (kind == tk_doc_comment() or kind == tk_error()) { return 1 }
    if (text == "(" or text == "[" or text == "{") { return 1 }
    if (text == "," or text == "." or text == "::" or text == "=" or text == "=>") { return 1 }
    if (text == "?" or text == "??" or text == "|>" or text == "|" or text == ".." or text == "..=") { return 1 }
    if (text == "+" or text == "-" or text == "*" or text == "/" or text == "%") { return 1 }
    if (text == "==" or text == "!=" or text == "<" or text == "<=" or text == ">" or text == ">=") { return 1 }
    if (text == "&&" or text == "||" or text == "&" or text == "^" or text == "<<" or text == ">>") { return 1 }
    if (text == "+=" or text == "-=" or text == "*=" or text == "/=" or text == "%=") { return 1 }
    if (text == "&=" or text == "|=" or text == "^=" or text == "<<=" or text == ">>=") { return 1 }
    if (kind == tk_keyword() and text != "return" and text != "break" and text != "continue" and text != "self") { return 1 }
    return 0
}

pub fn kix_next_token_continues_line(src: string, start: i32): i32
{
    let mut pos = start
    let mut block_depth = 0
    while (pos < src.length)
    {
        let c = compiler_string_byte(src, pos)
        if (c == 32 or c == 9 or c == 10 or c == 13) { pos += 1; continue }
        if (c == '/' and pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '/')
        {
            while (pos < src.length and compiler_string_byte(src, pos) != 10) { pos += 1 }
            continue
        }
        if (c == '/' and pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '*')
        {
            pos += 2
            block_depth = 1
            while (pos < src.length and block_depth > 0)
            {
                if (pos + 1 < src.length and compiler_string_byte(src, pos) == '/' and compiler_string_byte(src, pos + 1) == '*') { block_depth += 1; pos += 2 }
                elif (pos + 1 < src.length and compiler_string_byte(src, pos) == '*' and compiler_string_byte(src, pos + 1) == '/') { block_depth -= 1; pos += 2 }
                else { pos += 1 }
            }
            continue
        }
        if (is_alpha(c) == 1)
        {
            let mut word = ""
            while (pos < src.length and is_ident(compiler_string_byte(src, pos)) == 1)
            {
                word = word + char_string(compiler_string_byte(src, pos))
                pos += 1
            }
            if (word == "else") { return 1 }
            return 0
        }
        if (c == '}') { return 1 }
        if (c == '.' or c == '?' or c == '+' or c == '-' or c == '*' or c == '/' or c == '%' or c == '=' or c == '!' or c == '<' or c == '>' or c == '&' or c == '|' or c == '^') { return 1 }
        return 0
    }
    return 0
}

pub fn kix_newline_should_insert_semicolon(src: string, pos: i32, stream: &TokenStream, paren_depth: i32, bracket_depth: i32): i32
{
    if (paren_depth > 0 or bracket_depth > 0) { return 0 }
    if (stream_len(stream) == 0) { return 0 }
    let last = stream_len(stream) - 1
    let kind = stream_kind_at(stream, last)
    let text = stream_text_at(stream, last)
    if (text == ";") { return 0 }
    if (kix_token_cannot_end_line(kind, text) == 1) { return 0 }
    if (kix_next_token_continues_line(src, pos) == 1) { return 0 }
    return 1
}

pub fn kix_push_symbol(stream: &TokenStream, symbol: string, line: i32, column: i32, start: i32)
{
    stream_push_origin(stream, tk_symbol(), symbol, 0, 0.0, line, column, start, start + symbol.length, TokenCallSite, 0)
}

pub fn tokenize_kix(src: string): TokenStream
{
    let stream = stream_new()
    let mut pos = 0
    let mut line = 1
    let mut column = 1
    let mut paren_depth = 0
    let mut bracket_depth = 0

    while (pos < src.length)
    {
        let c = compiler_string_byte(src, pos)
        if (c == 32 or c == 13) { pos += 1; column += 1; continue }
        if (c == 9) { pos += 1; column = ((column - 1) / 8 + 1) * 8 + 1; continue }
        if (c == 10)
        {
            pos += 1
            if (kix_newline_should_insert_semicolon(src, pos, &stream, paren_depth, bracket_depth) == 1)
            {
                stream_push_origin(&stream, tk_symbol(), ";", 0, 0.0, line, column, pos - 1, pos, TokenGenerated, 0)
            }
            line += 1
            column = 1
            continue
        }

        if (c == '/' and pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '/')
        {
            let start_pos = pos
            let start_col = column
            let is_doc = if (pos + 2 < src.length and (compiler_string_byte(src, pos + 2) == '/' or compiler_string_byte(src, pos + 2) == '!')) { 1 } else { 0 }
            let is_module_doc = if (is_doc == 1 and compiler_string_byte(src, pos + 2) == '!') { 1 } else { 0 }
            pos += if (is_doc == 1) { 3 } else { 2 }
            column += if (is_doc == 1) { 3 } else { 2 }
            let mut text = ""
            while (pos < src.length and compiler_string_byte(src, pos) != 10)
            {
                if (is_doc == 1) { text = text + char_string(compiler_string_byte(src, pos)) }
                pos += 1
                column += 1
            }
            if (is_doc == 1)
            {
                stream_push_origin(&stream, tk_doc_comment(), text, is_module_doc, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
            }
            continue
        }

        if (c == '/' and pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '*')
        {
            let start_pos = pos
            let start_line = line
            let start_col = column
            let mut depth = 1
            let mut had_newline = 0
            pos += 2
            column += 2
            while (pos < src.length and depth > 0)
            {
                if (pos + 1 < src.length and compiler_string_byte(src, pos) == '/' and compiler_string_byte(src, pos + 1) == '*') { depth += 1; pos += 2; column += 2 }
                elif (pos + 1 < src.length and compiler_string_byte(src, pos) == '*' and compiler_string_byte(src, pos + 1) == '/') { depth -= 1; pos += 2; column += 2 }
                elif (compiler_string_byte(src, pos) == 10) { had_newline = 1; pos += 1; line += 1; column = 1 }
                else { pos += 1; column += 1 }
            }
            if (depth > 0)
            {
                stream_push_origin(&stream, tk_error(), "unterminated block comment", 0, 0.0, start_line, start_col, start_pos, pos, TokenCallSite, 0)
            }
            elif (had_newline == 1 and kix_newline_should_insert_semicolon(src, pos, &stream, paren_depth, bracket_depth) == 1)
            {
                stream_push_origin(&stream, tk_symbol(), ";", 0, 0.0, line, column, pos, pos, TokenGenerated, 0)
            }
            continue
        }

        if ((c == 'r' or c == 'b') and pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '"')
        {
            let start_pos = pos
            let start_col = column
            let kind = if (c == 'r') { tk_raw_string() } else { tk_byte_string() }
            let is_raw = if (c == 'r') { 1 } else { 0 }
            pos += 2
            column += 2
            let mut text = ""
            let mut closed = 0
            while (pos < src.length)
            {
                let ch = compiler_string_byte(src, pos)
                if (ch == '"') { pos += 1; column += 1; closed = 1; break }
                if (ch == 10) { break }
                if (is_raw == 0 and ch == 92 and pos + 1 < src.length)
                {
                    let next = compiler_string_byte(src, pos + 1)
                    text = text + match next { 'n' -> char_string(10) 't' -> char_string(9) 'r' -> char_string(13) '0' -> "\\0" 92 -> char_string(92) '"' -> char_string('"') _ -> char_string(next) }
                    pos += 2
                    column += 2
                }
                else { text = text + char_string(ch); pos += 1; column += 1 }
            }
            if (closed == 1) { stream_push_origin(&stream, kind, text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            else { stream_push_origin(&stream, tk_error(), "unterminated string", 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            continue
        }

        if (c == '"')
        {
            let start_pos = pos
            let start_col = column
            pos += 1
            column += 1
            let mut text = ""
            let mut closed = 0
            while (pos < src.length)
            {
                let ch = compiler_string_byte(src, pos)
                if (ch == '"') { pos += 1; column += 1; closed = 1; break }
                if (ch == 10) { break }
                if (ch == 92 and pos + 1 < src.length)
                {
                    let next = compiler_string_byte(src, pos + 1)
                    if (next == 'u' and pos + 2 < src.length and compiler_string_byte(src, pos + 2) == '{')
                    {
                        text = text + "\\u{"
                        pos += 3
                        column += 3
                        while (pos < src.length and compiler_string_byte(src, pos) != '}') { text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1 }
                        if (pos < src.length) { text = text + "}"; pos += 1; column += 1 }
                    }
                    else
                    {
                        text = text + match next { 'n' -> char_string(10) 't' -> char_string(9) 'r' -> char_string(13) '0' -> "\\0" 92 -> char_string(92) '"' -> char_string('"') 39 -> char_string(39) _ -> char_string(next) }
                        pos += 2
                        column += 2
                    }
                }
                else { text = text + char_string(ch); pos += 1; column += 1 }
            }
            if (closed == 1) { stream_push_origin(&stream, tk_string(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            else { stream_push_origin(&stream, tk_error(), "unterminated string", 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            continue
        }

        if (c == 39)
        {
            let start_pos = pos
            let start_col = column
            pos += 1
            column += 1
            let mut value = 0
            let mut valid = 1
            if (pos >= src.length or compiler_string_byte(src, pos) == 10) { valid = 0 }
            elif (compiler_string_byte(src, pos) == 92 and pos + 1 < src.length)
            {
                let next = compiler_string_byte(src, pos + 1)
                if (next == 'u' and pos + 2 < src.length and compiler_string_byte(src, pos + 2) == '{')
                {
                    pos += 3
                    column += 3
                    value = 0
                    let mut digits = 0
                    while (pos < src.length and compiler_string_byte(src, pos) != '}')
                    {
                        let digit = kix_digit_value(compiler_string_byte(src, pos))
                        if (digit < 0) { valid = 0 }
                        else { value = value * 16 + digit; digits += 1 }
                        pos += 1
                        column += 1
                    }
                    if (digits == 0 or pos >= src.length or compiler_string_byte(src, pos) != '}') { valid = 0 }
                    else { pos += 1; column += 1 }
                }
                else
                {
                    value = match next { 'n' -> 10 't' -> 9 'r' -> 13 '0' -> 0 92 -> 92 39 -> 39 '"' -> 34 _ -> next }
                    pos += 2
                    column += 2
                }
            }
            else { value = compiler_string_byte(src, pos); pos += 1; column += 1 }
            if (pos >= src.length or compiler_string_byte(src, pos) != 39) { valid = 0 }
            else { pos += 1; column += 1 }
            if (valid == 1) { stream_push_origin(&stream, tk_char(), "", value, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            else { stream_push_origin(&stream, tk_error(), "invalid character literal", 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            continue
        }

        if (is_alpha(c) == 1)
        {
            let start_pos = pos
            let start_col = column
            let mut text = ""
            while (pos < src.length and is_ident(compiler_string_byte(src, pos)) == 1)
            {
                text = text + char_string(compiler_string_byte(src, pos))
                pos += 1
                column += 1
            }
            if (text == "true") { stream_push_origin(&stream, tk_bool(), text, 1, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            elif (text == "false") { stream_push_origin(&stream, tk_bool(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            elif (is_kix_keyword(text) == 1) { stream_push_origin(&stream, tk_keyword(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            else { stream_push_origin(&stream, tk_ident(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            continue
        }

        if (is_digit(c) == 1)
        {
            let start_pos = pos
            let start_col = column
            let mut text = ""
            let mut is_float = 0
            let mut base = 10
            if (c == '0' and pos + 1 < src.length)
            {
                let marker = compiler_string_byte(src, pos + 1)
                if (marker == 'x' or marker == 'X') { base = 16 }
                elif (marker == 'o' or marker == 'O') { base = 8 }
                elif (marker == 'b' or marker == 'B') { base = 2 }
                if (base != 10) { text = text + "0" + char_string(marker); pos += 2; column += 2 }
            }
            while (pos < src.length and (kix_digit_valid(compiler_string_byte(src, pos), base) == 1 or compiler_string_byte(src, pos) == '_'))
            {
                text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1
            }
            if (base == 10 and pos < src.length and compiler_string_byte(src, pos) == '.' and pos + 1 < src.length and compiler_string_byte(src, pos + 1) != '.' and is_digit(compiler_string_byte(src, pos + 1)) == 1)
            {
                is_float = 1; text = text + "."; pos += 1; column += 1
                while (pos < src.length and (is_digit(compiler_string_byte(src, pos)) == 1 or compiler_string_byte(src, pos) == '_')) { text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1 }
            }
            if (base == 10 and pos < src.length and (compiler_string_byte(src, pos) == 'e' or compiler_string_byte(src, pos) == 'E'))
            {
                is_float = 1; text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1
                if (pos < src.length and (compiler_string_byte(src, pos) == '+' or compiler_string_byte(src, pos) == '-')) { text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1 }
                while (pos < src.length and (is_digit(compiler_string_byte(src, pos)) == 1 or compiler_string_byte(src, pos) == '_')) { text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1 }
            }
            while (pos < src.length and is_ident(compiler_string_byte(src, pos)) == 1) { text = text + char_string(compiler_string_byte(src, pos)); pos += 1; column += 1 }
            if (is_float == 1) { stream_push_origin(&stream, tk_float(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            else { stream_push_origin(&stream, tk_number(), text, kix_parse_small_int(text), 0.0, line, start_col, start_pos, pos, TokenCallSite, 0) }
            continue
        }

        let start_pos = pos
        let start_col = column
        let mut symbol = char_string(c)
        if (pos + 2 < src.length)
        {
            let pair = char_string(c) + char_string(compiler_string_byte(src, pos + 1))
            let triple = pair + char_string(compiler_string_byte(src, pos + 2))
            if (triple == "<<=" or triple == ">>=" or triple == "..=" or triple == "...") { symbol = triple }
        }
        if (symbol.length == 1 and pos + 1 < src.length)
        {
            let pair = char_string(c) + char_string(compiler_string_byte(src, pos + 1))
            if (pair == "=>" or pair == "==" or pair == "!=" or pair == "<=" or pair == ">=" or pair == "&&" or pair == "||" or pair == "<<" or pair == ">>" or pair == "+=" or pair == "-=" or pair == "*=" or pair == "/=" or pair == "%=" or pair == "&=" or pair == "|=" or pair == "^=" or pair == "::" or pair == "->" or pair == "**" or pair == "??" or pair == "|>" or pair == "..") { symbol = pair }
        }
        kix_push_symbol(&stream, symbol, line, start_col, start_pos)
        if (symbol == "(") { paren_depth += 1 }
        elif (symbol == ")" and paren_depth > 0) { paren_depth -= 1 }
        elif (symbol == "[") { bracket_depth += 1 }
        elif (symbol == "]" and bracket_depth > 0) { bracket_depth -= 1 }
        pos += symbol.length
        column += symbol.length
    }

    stream_push_origin(&stream, tk_eof(), "", 0, 0.0, line, column, pos, pos, TokenCallSite, 0)
    return stream
}

pub fn tokenize(src: string): TokenStream
{
    let stream = stream_new()
    let mut pos = 0
    let mut line = 1
    let mut column = 1

    while (pos < src.length)
    {
        match peek_char(src, pos)
        {
            Some(c) -> {
                match c {
                    32 | 13 -> {
                        pos += 1
                        column += 1
                    }
                    9 -> {
                        pos += 1
                        column = ((column - 1) / 8 + 1) * 8 + 1
                    }
                    10 -> {
                        pos += 1
                        if (newline_should_insert_semicolon(src, pos, &stream) == 1)
                        {
                            stream_push_origin(&stream, tk_symbol(), ";", 0, 0.0, line, column, pos - 1, pos, TokenGenerated, 0)
                        }
                        line += 1
                        column = 1
                    }
                    '/' -> {
                        if (pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '/')
                        {
                            while (pos < src.length and compiler_string_byte(src, pos) != 10)
                            {
                                pos += 1
                                column += 1
                            }
                        }
                        elif (pos + 1 < src.length and compiler_string_byte(src, pos + 1) == '*')
                        {
                            pos += 2
                            column += 2
                            let mut comment_had_newline = 0
                            while (pos + 1 < src.length and (compiler_string_byte(src, pos) != '*' or compiler_string_byte(src, pos + 1) != '/'))
                            {
                                if (compiler_string_byte(src, pos) == 10)
                                {
                                    comment_had_newline = 1
                                    line += 1
                                    column = 1
                                }
                                elif (compiler_string_byte(src, pos) == 9)
                                {
                                    column = ((column - 1) / 8 + 1) * 8 + 1
                                }
                                else
                                {
                                    column += 1
                                }
                                pos += 1
                            }
                            if (pos + 1 < src.length)
                            {
                                pos += 2
                                column += 2
                            }
                            if (comment_had_newline == 1 and newline_should_insert_semicolon(src, pos, &stream) == 1)
                            {
                                stream_push_origin(&stream, tk_symbol(), ";", 0, 0.0, line, column, pos, pos, TokenGenerated, 0)
                            }
                        }
                        else
                        {
                            stream_push_origin(&stream, tk_symbol(), char_string(c), 0, 0.0, line, column, pos, pos + 1, TokenCallSite, 0)
                            pos += 1
                            column += 1
                        }
                    }
                    39 -> {
                        if (pos + 1 < src.length and is_alpha(compiler_string_byte(src, pos + 1)) == 1 and (pos + 2 >= src.length or compiler_string_byte(src, pos + 2) != 39))
                        {
                            stream_push_origin(&stream, tk_symbol(), "'", 0, 0.0, line, column, pos, pos + 1, TokenCallSite, 0)
                            pos += 1
                            column += 1
                            continue
                        }
                    let start_col = column
                    let start_pos = pos
                    pos += 1
                    column += 1
                    let mut value: i32 = 0
                    if (pos < src.length)
                    {
                        if (compiler_string_byte(src, pos) == 92 and pos + 1 < src.length)
                        {
                            let next = compiler_string_byte(src, pos + 1)
                            if (next == '0' and pos + 3 < src.length and compiler_string_byte(src, pos + 2) == '3' and compiler_string_byte(src, pos + 3) == '3')
                            {
                                value = 27
                                pos += 4
                                column += 4
                            }
                            else
                            {
                                value = match next {
                                    'n' -> 10
                                    't' -> 9
                                    'r' -> 13
                                    '0' -> 0
                                    92 -> 92
                                    39 -> 39
                                    '"' -> 34
                                    _ -> next
                                }
                                pos += 2
                                column += 2
                            }
                        }
                        else
                        {
                            value = compiler_string_byte(src, pos)
                            pos += 1
                            column += 1
                        }
                    }
                    if (pos < src.length and compiler_string_byte(src, pos) == 39)
                    {
                        pos += 1
                        column += 1
                    }
                    stream_push_origin(&stream, tk_number(), "", value, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                    }
                    '"' -> {
                    let start_col = column
                    let start_pos = pos
                    let mut text = ""
                    pos += 1
                    column += 1
                    while (pos < src.length and compiler_string_byte(src, pos) != '"')
                    {
                        if (compiler_string_byte(src, pos) == 92 and pos + 1 < src.length)
                        {
                            let next = compiler_string_byte(src, pos + 1)
                            if (next == '0' and pos + 3 < src.length and compiler_string_byte(src, pos + 2) == '3' and compiler_string_byte(src, pos + 3) == '3')
                            {
                                text = text + char_string(27)
                                pos += 4
                                column += 4
                            }
                            else
                            {
                                text = text + match next {
                                    'n' -> char_string(10)
                                    't' -> char_string(9)
                                    'r' -> char_string(13)
                                    92 -> char_string(92)
                                    '"' -> char_string('"')
                                    _ -> char_string(next)
                                }
                                pos += 2
                                column += 2
                            }
                        }
                        else
                        {
                            text = text + char_string(compiler_string_byte(src, pos))
                            pos += 1
                            column += 1
                        }
                    }
                    if (pos < src.length and compiler_string_byte(src, pos) == '"')
                    {
                        pos += 1
                        column += 1
                    }
                    stream_push_origin(&stream, tk_string(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                    }
                    _ -> {
                        if (is_alpha(c) == 1)
                        {
                            let start_col = column
                            let start_pos = pos
                            let mut text = ""
                            while (pos < src.length and is_ident(compiler_string_byte(src, pos)) == 1)
                            {
                                text = text + char_string(compiler_string_byte(src, pos))
                                pos += 1
                                column += 1
                            }
                            match text {
                                "true" -> stream_push_origin(&stream, tk_bool(), text, 1, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                                "false" -> stream_push_origin(&stream, tk_bool(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                                _ -> {
                                    if (is_keyword(text) == 1)
                                    {
                                        stream_push_origin(&stream, tk_keyword(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                                    }
                                    else
                                    {
                                        stream_push_origin(&stream, tk_ident(), text, 0, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                                    }
                                }
                            }
                        }
                        elif (is_digit(c) == 1)
                        {
                            let start_col = column
                            let start_pos = pos
                            let mut value = 0
                            let mut text = ""
                            while (pos < src.length and is_digit(compiler_string_byte(src, pos)) == 1)
                            {
                                value = value * 10 + (compiler_string_byte(src, pos) - '0')
                                text = text + char_string(compiler_string_byte(src, pos))
                                pos += 1
                                column += 1
                            }
                            if (pos < src.length and compiler_string_byte(src, pos) == '.' and pos + 1 < src.length and is_digit(compiler_string_byte(src, pos + 1)) == 1)
                            {
                                text = text + "."
                                pos += 1
                                column += 1
                                while (pos < src.length and is_digit(compiler_string_byte(src, pos)) == 1)
                                {
                                    text = text + char_string(compiler_string_byte(src, pos))
                                    pos += 1
                                    column += 1
                                }
                                stream_push_origin(&stream, tk_float(), text, 0, atof(text), line, start_col, start_pos, pos, TokenCallSite, 0)
                            }
                            else
                            {
                                stream_push_origin(&stream, tk_number(), "", value, 0.0, line, start_col, start_pos, pos, TokenCallSite, 0)
                            }
                        }
                        else
                        {
                            let mut symbol = char_string(c)
                            let mut symbol_len = 1
                            if (pos + 1 < src.length)
                            {
                                let next = compiler_string_byte(src, pos + 1)
                                match c {
                                    '=' -> {
                                        if (next == '>') symbol = "=>"
                                        elif (next == '=') { symbol = "==" }
                                    }
                                    '!' -> {
                                        if (next == '=') symbol = "!="
                                    }
                                    '<' -> {
                                        if (next == '=') symbol = "<="
                                        elif (next == '<') { symbol = "<<" }
                                    }
                                    '>' -> {
                                        if (next == '=') symbol = ">="
                                        elif (next == '>') { symbol = ">>" }
                                    }
                                    '+' -> {
                                        if (next == '=') symbol = "+="
                                    }
                                    '-' -> {
                                        if (next == '=') symbol = "-="
                                        elif (next == '>') { symbol = "->" }
                                    }
                                    '*' -> {
                                        if (next == '*') symbol = "**"
                                    }
                                     '.' -> {
                                        if (next == '.' and pos + 2 < src.length and compiler_string_byte(src, pos + 2) == '.')
                                        {
                                            symbol = "..."
                                        }
                                        elif (next == '.')
                                        {
                                            symbol = ".."
                                        }
                                    }
                                    ':' -> {
                                        if (next == ':') symbol = "::"
                                    }
                                    '?' -> {
                                        if (next == '?') symbol = "??"
                                    }
                                    '|' -> {
                                        if (next == '>') symbol = "|>"
                                    }
                                    _ -> {}
                                }
                                symbol_len = symbol.length
                            }
                            stream_push_origin(&stream, tk_symbol(), symbol, 0, 0.0, line, column, pos, pos + symbol_len, TokenCallSite, 0)
                            pos += symbol_len
                            column += symbol_len
                        }
                    }
                }
            }
            None -> pos = src.length
        }
    }

    stream_push_origin(&stream, tk_eof(), "", 0, 0.0, line, column, pos, pos, TokenCallSite, 0)
    return stream
}

pub fn tokenize_debug(src: string): string
{
    let stream = src
        |> tokenize
    let mut out = ""
    for (i in 0 .. stream_len(stream))
    {
        let kind = stream_kind_at(stream, i)
        let text = stream_text_at(stream, i)
        let rendered = match kind {
            1 -> "Token(kind=ident, text='" + text + "')\n"
            2 -> "Token(kind=number, int=" + i32_to_str(stream_int_at(stream, i)) + ")\n"
            3 -> "Token(kind=keyword, text='" + text + "')\n"
            4 -> "Token(kind=symbol, text='" + text + "')\n"
            5 -> "Token(kind=string, text='" + text + "')\n"
            7 -> "Token(kind=bool, text='" + text + "', value=" + i32_to_str(stream_int_at(stream, i)) + ")\n"
            8 -> "Token(kind=float, text='" + text + "', value=" + f64_to_str(stream_float_at(stream, i)) + ")\n"
            _ -> "Token(kind=eof)\n"
        }
        out = out + rendered
    }
    return out
}

pub fn kix_debug_escape(text: string): string
{
    let mut out = ""
    for (i in 0 .. text.length)
    {
        let c = compiler_string_byte(text, i)
        if (c == 10) { out = out + "\\n" }
        elif (c == 9) { out = out + "\\t" }
        elif (c == 13) { out = out + "\\r" }
        elif (c == 39) { out = out + "\\'" }
        elif (c == 92) { out = out + "\\\\" }
        else { out = out + char_string(c) }
    }
    return out
}

pub fn tokenize_kix_debug(src: string): string
{
    let stream = tokenize_kix(src)
    let mut out = ""
    for (i in 0 .. stream_len(stream))
    {
        let kind = stream_kind_at(stream, i)
        let text = kix_debug_escape(stream_text_at(stream, i))
        let rendered = match kind {
            1 -> "ident '" + text + "'"
            2 -> "int '" + text + "' value=" + i32_to_str(stream_int_at(stream, i))
            3 -> "keyword '" + text + "'"
            4 -> "symbol '" + text + "'"
            5 -> "string '" + text + "'"
            6 -> "eof"
            7 -> "bool '" + text + "'"
            8 -> "float '" + text + "'"
            9 -> "char value=" + i32_to_str(stream_int_at(stream, i))
            10 -> "raw-string '" + text + "'"
            11 -> "byte-string '" + text + "'"
            12 -> if (stream_int_at(stream, i) == 1) { "module-doc '" + text + "'" } else { "item-doc '" + text + "'" }
            13 -> "error '" + text + "'"
            _ -> "unknown"
        }
        if (i > 0) { out = out + "\n" }
        out = out + i32_to_str(stream_line_at(stream, i)) + ":" + i32_to_str(stream_col_at(stream, i)) + " " + rendered
    }
    return out
}

pub fn tokenize_kix_has_error(src: string): i32
{
    let stream = tokenize_kix(src)
    for (i in 0 .. stream_len(stream))
    {
        if (stream_kind_at(stream, i) == tk_error()) { return 1 }
    }
    return 0
}
